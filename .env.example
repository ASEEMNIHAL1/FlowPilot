# Copy to .env in the repository root or backend/ and fill in values.
# Never commit real API keys.

# Asia/Kolkata (IST, UTC+5:30). All scheduling is timezone-aware.
FLOWPILOT_TIMEZONE=Asia/Kolkata

# SQLite URL. Relative paths are resolved from the backend working directory.
FLOWPILOT_DATABASE_URL=sqlite:///./flowpilot.db

# LLM provider: "openai" or "dev"
# Use "dev" for the labeled deterministic planner (no paid API calls).
FLOWPILOT_LLM_PROVIDER=openai

# Required only when FLOWPILOT_LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# --- To use Google Gemini API ---
# 1. Set FLOWPILOT_LLM_PROVIDER=openai
# 2. Get a free API key from Google AI Studio (https://aistudio.google.com/)
# 3. Use Gemini's OpenAI-compatible endpoint:
# OPENAI_API_KEY=AIzaSy...
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# OPENAI_MODEL=gemini-1.5-flash    # or gemini-2.0-flash, gemini-1.5-pro

# Agent loop bounds
FLOWPILOT_MAX_TOOL_CALLS=24
FLOWPILOT_MAX_RETRIES=2
FLOWPILOT_MAX_REPAIR_ATTEMPTS=1
FLOWPILOT_RUN_TIMEOUT_SECONDS=90
FLOWPILOT_MAX_GOAL_LENGTH=4000

# Default working hours in FLOWPILOT_TIMEZONE (noncritical preferences)
FLOWPILOT_WORK_START=09:00
FLOWPILOT_WORK_END=19:00
FLOWPILOT_LUNCH_START=12:00
FLOWPILOT_LUNCH_END=13:00
